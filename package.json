{
  "name": "n19",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/local.ts dev",
    "build": "bun run --filter @n19/web build",
    "start": "bun scripts/local.ts start",
    "lint": "bun run --filter @n19/web lint",
    "test": "bun test packages apps/api",
    "db:init": "bun packages/database/src/cli.ts init",
    "db:migrate:postgres": "bun packages/database/src/cli.ts migrate-postgres"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
